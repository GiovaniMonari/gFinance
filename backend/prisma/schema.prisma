generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  finances Finance[]
}

model Finance {
  id                String            @id @default(cuid())
  userId            String            @unique
  monthlyIncome     Decimal           @default(0)
  transactions      Transaction[]
  categories        Category[]
  recurringExpenses RecurringExpense[]
  financialGoals FinancialGoal[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  receipts Receipt[]
  user User @relation(fields: [userId], references: [id])
}

enum TransactionSource {
  MANUAL
  OPEN_FINANCE
  RECEIPT
  RECURRING
}

model Transaction {
  id          String            @id @default(cuid())
  financeId   String
  categoryId  String?
  receiptId   String?           @unique
  amount      Decimal
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  description String?
  source      TransactionSource @default(MANUAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  receipt  Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  finance  Finance   @relation(fields: [financeId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Category {
  id                String             @id @default(cuid())
  financeId         String
  name              String
  createdAt         DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  finance           Finance            @relation(fields: [financeId], references: [id])
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]

  @@unique([financeId, name])
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INCOME
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model RecurringExpense {
  id             String   @id @default(cuid())
  financeId      String
  categoryId     String?
  description    String?
  amount         Decimal
  dayOfMonth     Int
  nextExecution  DateTime
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  finance  Finance   @relation(fields: [financeId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([financeId, active])
  @@index([nextExecution])
}

model FinancialGoal {
  id            String   @id @default(cuid())
  financeId     String
  name          String
  targetAmount  Decimal
  currentAmount Decimal  @default(0)
  deadline      DateTime?
  transactions FinancialGoalTransaction[]
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  finance Finance @relation(fields: [financeId], references: [id], onDelete: Cascade)
}

model FinancialGoalTransaction {
  id        String   @id @default(uuid())
  goalId    String
  type      FinancialGoalTransactionType
  amount    Decimal
  createdAt DateTime @default(now())

  goal FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

enum FinancialGoalTransactionType {
  DEPOSIT
  WITHDRAW
}

model Receipt {
  id        String        @id @default(cuid())
  financeId String
  merchant  String?
  total     Decimal?
  date      DateTime?
  status    ReceiptStatus @default(PROCESSING)
  imageUrl  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  finance     Finance     @relation(fields: [financeId], references: [id], onDelete: Cascade)
  transaction Transaction?
  items       ReceiptItem[]

  @@index([financeId])
}

enum ReceiptStatus {
  PROCESSING
  PROCESSED
  PENDING_CONFIRMATION
  CONFIRMED
  FAILED
}

model ReceiptItem {
  id          String   @id @default(cuid())
  receiptId   String
  name        String
  quantity    Decimal?
  unitPrice   Decimal?
  totalPrice  Decimal?
  createdAt   DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}